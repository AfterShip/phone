{
  "name": "phone",
  "version": "3.1.72",
  "description": "With a given country and phone number, validate and format the phone number to E.164 standard",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=12"
  },
  "scripts": {
    "test": "node --require ttsc/register --test \"__tests__/**/*.ts\"",
    "test:watch": "node --require ttsc/register --test --watch \"__tests__/**/*.ts\"",
    "lint": "ttsc --noEmit && ttsc --noEmit -p __tests__/tsconfig.json",
    "format": "ttsc format && ttsc format -p __tests__/tsconfig.json",
    "build": "rimraf ./dist && ttsc",
    "pack:dry-run": "yarn build && npm pack --dry-run",
    "start:example": "yarn build && webpack serve --config ./example/webpack.config.js --progress",
    "dev": "yarn start:example",
    "prepublishOnly": "yarn build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aftership/phone"
  },
  "bugs": {
    "url": "https://github.com/aftership/phone/issues"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@ttsc/lint": "^0.34.1",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "babel-loader": "^10.1.1",
    "babel-polyfill": "^6.26.0",
    "papaparse": "^5.7.0",
    "rimraf": "^6.1.3",
    "ttsc": "^0.34.1",
    "typescript": "^7.0.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0"
  },
  "keywords": [
    "phone",
    "e.164"
  ],
  "author": "AfterShip",
  "license": "MIT",
  "dependencies": {}
}
